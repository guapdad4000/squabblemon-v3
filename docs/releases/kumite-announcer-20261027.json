      "chapterLocalStart": 97.86925,
      "chapterLocalEnd": 99.9340625,
      "tempo": 1.08,
      "processedSHA256": "9b1fb85cc589ebe9a991f70f2b995719a603978f1487ef0375802aeb69847331"
    },
    {
      "id": "ANN42",
      "text": "What a fight! What a tournament!",
