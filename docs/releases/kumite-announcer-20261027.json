      "masterStart": 889.1264583333333,
      "masterEnd": 891.5153541666666,
      "chapterLocalStart": 80.75979166666667,
      "chapterLocalEnd": 83.1486875,
      "tempo": 1.08,
      "processedSHA256": "69f2ef74195b8d43f81b5e382435993f39bc8c74a1423f10483132488de3df26"
    },
    {
      "id": "ANN36",
      "text": "Ha! And his cheating partner brings the heat\u2014literally!",
