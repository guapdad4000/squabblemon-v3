      "masterStart": 898.4546041666666,
      "masterEnd": 902.1675625,
      "chapterLocalStart": 90.0879375,
      "chapterLocalEnd": 93.80089583333333,
      "tempo": 1.08,
      "processedSHA256": "0a07fe74fcaf45224569e308a4c99c11f4828d0119d2ee0432f46f1655636486"
    },
    {
