      "id": "ANN32",
      "text": "And we are off! What a start!",
      "chapter": 8,
      "masterStart": 881.59,
      "masterEnd": 883.84925,
      "chapterLocalStart": 73.22333333333333,
      "chapterLocalEnd": 75.48258333333334,
      "tempo": 1.08,
      "processedSHA256": "96459341025cabd877b821197b294f25f8a0a149eac1b9ac41873c7c5a4a565e"
    },
    {
      "id": "ANN33",
      "text": "Whoa! Did you see that? The Golden Glo Hero strikes first!",
      "chapter": 8,
      "masterStart": 883.9416458333334,
      "masterEnd": 887.6360833333333,
      "chapterLocalStart": 75.57497916666667,
      "chapterLocalEnd": 79.26941666666667,
      "tempo": 1.08,
      "processedSHA256": "b2d4fbd7c12eda279451fdb0b780b74e7f608f124920c9d37f5182906543ffd9"
