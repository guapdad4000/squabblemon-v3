      "masterStart": 891.5753541666667,
      "masterEnd": 894.7883125,
      "chapterLocalStart": 83.2086875,
      "chapterLocalEnd": 86.42164583333333,
      "tempo": 1.08,
      "processedSHA256": "841f7ddc87a5a3568042a8446817d1c42e7b325b8c45fdc4ddddb4e77c022ac7"
    },
    {
      "id": "ANN37",
      "text": "Ooh, smooth! The stylish technician is composed!",
      "chapter": 8,
      "masterStart": 894.8483125,
      "masterEnd": 898.3946041666667,
      "chapterLocalStart": 86.48164583333333,
      "chapterLocalEnd": 90.0279375,
      "tempo": 1.08,
      "processedSHA256": "d855bb587f7f26fad10280df0a7d11172d68c5a9ad29bbca8e8826422aa408df"
    },
