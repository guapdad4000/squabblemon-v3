      "masterEnd": 906.1759166666667,
      "chapterLocalStart": 95.45739583333334,
      "chapterLocalEnd": 97.80925,
      "tempo": 1.08,
      "processedSHA256": "edb7d77c9ab3ba67292be73c93b02700a19d55868d0e5b455f6719c19dd7f63f"
    },
    {
      "id": "ANN41",
      "text": "The goofy competitor gives it his all!",
