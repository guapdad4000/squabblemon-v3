      "masterStart": 843.8803541666666,
      "masterEnd": 845.9428541666666,
      "chapterLocalStart": 35.5136875,
      "chapterLocalEnd": 37.5761875,
      "tempo": 1.12,
      "processedSHA256": "08b29d6927779c19d12af86e16e56593d7874d1f3a958cac1232078bc43acef6"
    },
    {
      "id": "ANN29",
      "text": "Looks like our secret agent has some tricks up his sleeve, too!",
      "chapter": 8,
      "masterStart": 845.9628541666667,
      "masterEnd": 848.7396458333334,
      "chapterLocalStart": 37.5961875,
      "chapterLocalEnd": 40.37297916666667,
      "tempo": 1.12,
      "processedSHA256": "7a2f9a0d485c62bbd7e4af761a3853eb0e53fb9ef21ded3f588bfd4f6ceefc79"
    },
    {
      "id": "ANN30",
      "text": "What a night! What a tournament!",
      "chapter": 8,
      "masterStart": 848.7596458333334,
      "masterEnd": 850.6971458333334,
      "chapterLocalStart": 40.39297916666667,
      "chapterLocalEnd": 42.33047916666667,
      "tempo": 1.12,
      "processedSHA256": "8fa2a6092ef9f8b61cf599080e0eb124dcac9fcee11464da51af81da0aa45b61"
    },
    {
      "id": "ANN31",
      "text": "Stay tuned, folks!",
      "chapter": 8,
      "masterStart": 850.7171458333333,
      "masterEnd": 851.86,
      "chapterLocalStart": 42.350479166666666,
      "chapterLocalEnd": 43.49333333333333,
      "tempo": 1.12,
      "processedSHA256": "6b8605d4158e45f01c97c644d01b32b9dd6859e379026b3f165742226bb5715f"
    },
