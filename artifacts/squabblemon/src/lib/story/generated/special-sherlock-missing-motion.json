":4,"cpu":0}},"phases":[],"starObjectives":[{"id":"win","description":"Win the encounter.","criterion":{"kind":"win"}},{"id":"outside","description":"Finish holding both outside districts.","criterion":{"kind":"specific-districts-held","owner":"player","lanes":[0,2]}},{"id":"motion","description":"Finish with at least 1 Motion.","criterion":{"kind":"motion-remaining","owner":"player","atLeast":1}}]},"preDialogue":[{"speaker":"Sherlock","portraitAssetId":"assets/characters/sherlock.webp","text":"Four-round reconstruction. Hold both outside districts if you want the clean version. Cornball, the glitter is not evidence."}],"postDialogue":[{"speaker":"Sherlock","portraitAssetId":"assets/characters/sherlock.webp","text":"Good. The circular dust mark proves the reel left the canister, but never reached this projector."},{"speaker":"Cornball","portraitAssetId":"assets/characters/cornball.webp","text":"So the machine is innocent. Please remove its little sign before it gets management ideas."}],"starObjectives":[{"id":"win","description":"Win the encounter.","criterion":{"kind":"win"}},{"id":"outside","description":"Finish holding both outside districts.","criterion":{"kind":"specific-districts-held","owner":"player","lanes":[0,2]}},{"id":"motion","description":"Finish with at least 1 Motion.","criterion":{"kind":"motion-remaining","owner":"player","atLeast":1}}],"recommendedCollection":["cornball","plug","hooper"],"battlefieldAssetId":"assets/story/environments/backgrounds/01-after-hours-block-party.webp"},{"id":"sherlock-alices-alibi-maze","kind":"battle","battleType":"rule-twist","title":"Alice's Alibi Maze","mapPosition":{"x":63,"y":38},"prerequisites":["sherlock-test-the-witness"],"optional":false,"rewards":[{"kind":"currency","id":"street-xp","amount":125},{"kind":"currency","id":"clout","amount":100,"claimKey":"story-payout-contract:v1:sherlock-alices-alibi-maze:clout"},{"kind":"pack-ticket","id":"street-pack-ticket","amount":1,"claimKey":"story-payout-contract:v1:sh