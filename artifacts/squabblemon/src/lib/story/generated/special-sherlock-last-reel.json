{"revision":"46a5a080a9c58ac0bca4880a2b00ce64abe85446aa97935088b2a2d8ef4b2d92","chapterRevision":"f752db78c2107ff77a29b1c9ec403fa852ca47901b0b6375539783e30e03ddcb","chapter":{"id":"special-sherlock-last-reel","order":19,"title":"The Missing Motion, Part III","subtitle":"The impossible date gives up the culprit.","description":"The crew reconstructs the theft, earns a confession, and saves the screening.","mapAssetId":"assets/story/environments/backgrounds/03-promoters-back-office.webp","prerequisites":["special-sherlock-false-bottom"],"nodes":[{"id":"sherlock-impossible-date","kind":"reward","title":"The Impossible Date","mapPosition":{"x":7,"y":79},"prerequisites":[],"optional":false,"rewards":[{"kind":"currency","id":"clout","amount":100,"claimKey":"story-payout-contract:v1:sherlock-impossible-date:clout"},{"kind":"pack-ticket","id":"street-pack-ticket","amount":1,"claimKey":"story-payout-contract:v1:sherlock-impossible-date:ticket"}],"teaching":{"tips":["Read every statement before advancing the investigation."],"focusMechanics":["story investigation"],"focusCards":["sherlock"]},"cinematic":{"videoAssetId":"assets/story/chapter-one/media/standard-clash.mp4","posterAssetId":"assets/story/theater/sherlock.webp","environmentAssetId":"assets/story/environments/backgrounds/03-promoters-back-office.webp"},"scenes":[{"speaker":"Sherlock","portraitAssetId":"assets/characters/sherlock.webp","text":"The removed title card advertises the premiere on Tuesday, February thirty-first."},{"speaker":"Promoter","portraitAssetId":"assets/characters/promoter.webp","text":"I approved it hungry. Then I saw the date after two hundred tickets sold. I was trying to fix it before the group chat ate me alive."},{"speaker":"Snitch","portraitAssetId":"assets/characters/snitch.webp","text":"You manufactured a reel theft to avoid a typo reveal. That is premium behavior."},{"speaker":"Alice","portraitAssetId":"assets/characters/alice.webp","text":"You staged a disappearance because February embarrassed you. That is an expensive relationship with a calendar."}]},{"id":"sherlock-cornballs-reconstruction","kind":"battle","battleType":"rule-twist","title":"Cornball's Reconstruction","mapPosition":{"x":32,"y":59},"prerequisites":["sherlock-impossible-date"],"optional":false,"rewards":[{"kind":"currency","id":"street-xp","amount":100},{"kind":"currency","id":"clout","amount":100,"claimKey":"story-payout-contract:v1:sherlock-cornballs-reconstruction:clout"},{"kind":"pack-ticket","id":"street-pack-ticket","amount":1,"claimKey":"story-payout-contract:v1:sherlock-cornballs-reconstruction:ticket"}],"teaching":{"tips":["This testimony match lasts 4 rounds.","Hold the outside districts while preserving Motion."],"focusMechanics":["specific districts","Motion management"],"focusCards":["cornball","plug","hooper"]},"cinematic":{"videoAssetId":"assets/story/chapter-one/media/standard-clash.mp4","posterAssetId":"assets/story/theater/sherlock.webp","environmentAssetId":"assets/story/environments/backgrounds/02-bootleg-film-archive.webp"},"encounter":{"id":"sherlock-cornballs-reconstruction","enemy":{"id":"sherlock-cornballs-reconstruction:enemy","name":"Cornball","portraitAssetId":"assets/characters/cornball.webp","deckId":"sherlock-cornballs-reconstruction-deck","cardIds":["sherlock","alice","cornball","nerd","snow","plug","hooper","buspass","soulfood","cognac"],"behaviorProfile":"balanced"},"battlefieldAssetId":"assets/story/environments/backgrounds/02-bootleg-film-archive.webp","cinematic":{"videoAssetId":"assets/story/chapter-one/media/standard-clash.mp4","posterAssetId":"assets/story/theater/sherlock.webp","environmentAssetId":"assets/venues/red-fence-night-court.webp"},"soundHooks":{"intro":"story.encounter.intro","play":"story.card.play","phase":"story.boss.phase","victory":"story.victory","defeat":"story.defeat"},"roundLimit":4,"modifiers":{"startingMotion":{"player":4,"cpu":0},"laneLocks":[{"round":3,"owner":"both","lanes":[1]}]},"phases":[],"starObjectives":[{"id":"win","description":"Win the encounter.","criterion":{"kind":"win"}},{"id":"outside","description":"Finish holding both outside districts.","criterion":{"kind":"specific-districts-held","owner":"player","lanes":[0,2]}},{"id":"motion","description":"Finish with at least 1 Motion.","criterion":{"kind":"motion-remaining","owner":"player","atLeast":1}}]},"preDialogue":[{"speaker":"Cornball","portraitAssetId":"assets/characters/cornball.webp","text":"I will reconstruct the canister handoff using cups, string, and this unsweetened sparkling water."},{"speaker":"Sherlock","portraitAssetId":"assets/characters/sherlock.webp","text":"Or we can play one short match and preserve the cups."}],"postDialogue":[{"speaker":"Cornball","portraitAssetId":"assets/characters/cornball.webp","text":"Reconstruction complete. Promoter asked me for the key, then returned it under the water receipt."},{"speaker":"Sherlock","portraitAssetId":"assets/characters/sherlock.webp","text":"That explains the unforced lock and your fingerprints without making you the thief."}],"starObjectives":[{"id":"win","description":"Win the encounter.","criterion":{"kind":"win"}},{"id":"outside","description":"Finish holding both outside districts.","criterion":{"kind":"specific-districts-held","owner":"player","lanes":[0,2]}},{"id":"motion","description":"Finish with at least 1 Motion.","criterion":{"kind":"motion-remaining","owner":"player","atLeast":1}}],"recommendedCollection":["cornball","plug","hooper"],"battlefieldAssetId":"assets/story/environments/backgrounds/02-bootleg-film-archive.webp"},{"id":"sherlock-final-deduction","kind":"battle","battleType":"boss","title":"The Final Deduction","mapPosition":{"x":61,"y":38},"prerequisites":["sherlock-cornballs-reconstruction"],"optional":false,"rewards":[{"kind":"currency","id":"street-xp","amount":150},{"kind":"currency","id":"clout","amount":200,"claimKey":"story-payout-contract:v1:sherlock-final-deduction:clout"},{"kind":"pack-ticket","id":"street-pack-ticket","amount":1,"claimKey":"story-payout-contract:v1:sherlock-final-deduction:ticket"}],"teaching":{"tips":["This testimony match lasts 6 rounds.","Hold the outside districts while preserving Motion."],"focusMechanics":["specific districts","Motion management"],"focusCards":["cornball","plug","hooper"]},"cinematic":{"videoAssetId":"assets/story/chapter-one/media/standard-clash.mp4","posterAssetId":"assets/story/theater/sherlock.webp","environmentAssetId":"assets/story/environments/backgrounds/03-promoters-back-office.webp"},"encounter":{"id":"sherlock-final-deduction","enemy":{"id":"sherlock-final-deduction:enemy","name":"Promoter","portraitAssetId":"assets/characters/promoter.webp","deckId":"sherlock-final-deduction-deck","cardIds":["techbro","nerd","streamer","cornball","roaster","snow","plug","buspass","soulfood","cognac"],"behaviorProfile":"combo-boss"},"battlefieldAssetId":"assets/story/environments/backgrounds/03-promoters-back-office.webp","cinematic":{"videoAssetId":"assets/story/chapter-one/media/standard-clash.mp4","posterAssetId":"assets/story/theater/sherlock.webp","environmentAssetId":"assets/venues/crown-rooftop-court.webp"},"soundHooks":{"intro":"story.encounter.intro","play":"story.card.play","phase":"story.boss.phase","victory":"story.victory","defeat":"story.defeat"},"roundLimit":6,"modifiers":{"startingMotion":{"player":4,"cpu":1}},"phases":[{"id":"final-deduction","name":"Final Deduction","description":"At round four, the last hidden detail gives the opponent 1 Motion.","trigger":{"kind":"round","atLeast":4},"onEnter":[{"kind":"motion","owner":"cpu","amount":1}]}],"starObjectives":[{"id":"win","description":"Win the encounter.","criterion":{"kind":"win"}},{"id":"outside","description":"Finish holding both outside districts.","criterion":{"kind":"specific-districts-held","owner":"player","lanes":[0,2]}},{"id":"motion","description":"Finish with at least 1 Motion.","criterion":{"kind":"motion-remaining","owner":"player","atLeast":1}}]},"preDialogue":[{"speaker":"Sherlock","portraitAssetId":"assets/characters/sherlock.webp","text":"The reel, the key, the false panel, and the impossible date now tell one story."},{"speaker":"Promoter","portraitAssetId":"assets/characters/promoter.webp","text":"Then give me one final table before you tell it to everybody with tickets."}],"postDialogue":[{"speaker":"Promoter","portraitAssetId":"assets/characters/promoter.webp","text":"I took the reel to replace the date. The power returned early, so I hid it and pretended the canister had arrived empty."},{"speaker":"Sherlock","portraitAssetId":"assets/characters/sherlock.webp","text":"You could have printed a correction. Instead you gave a trophy a secret compartment. Be embarrassed cheaper next time."}],"starObjectives":[{"id":"win","description":"Win the encounter.","criterion":{"kind":"win"}},{"id":"outside","description":"Finish holding both outside districts.","criterion":{"kind":"specific-districts-held","owner":"player","lanes":[0,2]}},{"id":"motion","description":"Finish with at least 1 Motion.","criterion":{"kind":"motion-remaining","owner":"player","atLeast":1}}],"recommendedCollection":["cornball","plug","hooper"],"battlefieldAssetId":"assets/story/environments/backgrounds/03-promoters-back-office.webp"},{"id":"sherlock-the-missing-motion","kind":"reward","title":"The Missing Motion","mapPosition":{"x":87,"y":19},"prerequisites":["sherlock-final-deduction"],"optional":false,"rewards":[{"kind":"currency","id":"clout","amount":100,"claimKey":"story-payout-contract:v1:sherlock-the-missing-motion:clout"},{"kind":"pack-ticket","id":"street-pack-ticket","amount":1,"claimKey":"story-payout-contract:v1:sherlock-the-missing-motion:ticket"}],"teaching":{"tips":["Read every statement before advancing the investigation."],"focusMechanics":["story investigation"],"focusCards":["sherlock"]},"cinematic":{"videoAssetId":"assets/story/chapter-one/media/standard-clash.mp4","posterAssetId":"assets/story/theater/sherlock.webp","environmentAssetId":"assets/story/environments/backgrounds/01-after-hours-block-party.webp"},"scenes":[{"speaker":"Sherlock","portraitAssetId":"assets/characters/sherlock.webp","text":"Promoter took the key, hid the reel, and blamed a case that arrived empty. Alley’s photo clears Alley; the film leader and clipboard dust put the reel with Promoter."},{"speaker":"Promoter","portraitAssetId":"assets/characters/promoter.webp","text":"I will announce the typo, credit Alley’s receipt, and screen the reel untouched."},{"speaker":"Snitch","portraitAssetId":"assets/characters/snitch.webp","text":"My headline is now LOCAL DATE FOUND INNOCENT. The calendar has declined comment."},{"speaker":"Alice","portraitAssetId":"assets/characters/alice.webp","text":"Lights down. Mystery over. Someone move the eighth fog machine before it develops an alibi."},{"speaker":"Cornball","portraitAssetId":"assets/characters/cornball.webp","text":"And the projector’s interview ban?"},{"speaker":"Sherlock","portraitAssetId":"assets/characters/sherlock.webp","text":"Lifted. It has been cleared of all charges except chewing coupons."}]},{"id":"sherlock-curtain-call","kind":"reward","title":"Curtain Call","mapPosition":{"x":96,"y":7},"prerequisites":["sherlock-the-missing-motion"],"optional":false,"rewards":[{"kind":"card","id":"sherlock","amount":1},{"kind":"pack-ticket","id":"street-pack-ticket","amount":5},{"kind":"currency","id":"street-xp","amount":300},{"kind":"currency","id":"clout","amount":250,"claimKey":"story-payout-contract:v1:sherlock-curtain-call:clout"},{"kind":"pack-ticket","id":"street-pack-ticket","amount":5,"claimKey":"story-payout-contract:v1:sherlock-curtain-call:ticket"}],"teaching":{"tips":["Read every statement before advancing the investigation."],"focusMechanics":["story investigation"],"focusCards":["sherlock"]},"cinematic":{"videoAssetId":"assets/story/chapter-one/media/standard-clash.mp4","posterAssetId":"assets/story/theater/sherlock.webp","environmentAssetId":"assets/story/environments/backgrounds/01-after-hours-block-party.webp"},"scenes":[{"speaker":"Promoter","portraitAssetId":"assets/characters/promoter.webp","text":"The corrected title card is on screen, the reel is home, and every borrowed item is in the public inventory."},{"speaker":"Sherlock","portraitAssetId":"assets/characters/sherlock.webp","text":"Then our fee is simple: keep the evidence board available and the screening open to the block."},{"speaker":"Alice","portraitAssetId":"assets/characters/alice.webp","text":"Also keep one fog machine. A curtain call should look faintly suspicious."}]}]}}
