{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:balance": "pnpm --filter @workspace/scripts test",
    "balance:smoke": "pnpm --filter @workspace/scripts balance:smoke",
    "balance:full": "pnpm --filter @workspace/scripts balance:full",
    "test:campaign:db": "node scripts/test-api-database.mjs",
    "test:campaign:preflight": "node scripts/campaign-e2e-preflight.mjs",
    "test:campaign:remote": "node scripts/campaign-remote.mjs",
    "test:campaign:cleanup": "pnpm --filter @workspace/api-server exec tsx ../../scripts/campaign-cleanup.mjs",
    "test:fade-park": "node scripts/test-api-database.mjs fade-park"
  },
  "private": true,
  "dependencies": {
    "@netlify/database": "^2.0.1",
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "esbuild": "0.27.3",
    "prettier": "^3.9.4",
    "typescript": "~5.9.3",
    "vite": "7.3.2"
  }
}
